# Image version used by the generic production Compose.
# `latest` is updated only by stable GitHub Releases. Pin an exact version
# (for example 2.0.0) when predictable rollback is more important.
TACHO_VERSION=latest
TACHO_PORT=8000

POSTGRES_USER=tacho
POSTGRES_DB=tacho

# The production Compose generates and persists the PostgreSQL password and
# AUTH_SECRET automatically in the `tacho_secrets` volume. Do not add them here.

# Use true when Tacho is served to browsers over HTTPS.
AUTH_COOKIE_SECURE=false

# Optional canonical URLs. Leave empty for direct access on localhost.
PUBLIC_BASE_URL=
SHARE_BASE_URL=

# JSON list of allowed browser origins. Same-origin production normally needs
# only the URL through which users access Tacho.
CORS_ORIGINS=["http://localhost:8000"]

# Optional recipe extraction through Google Gemini.
GEMINI_API_KEY=

# Optional forward-auth integration. Keep disabled unless a trusted reverse
# proxy removes client-supplied headers and injects both identity and secret.
TRUST_FORWARD_AUTH=false
FORWARD_AUTH_SECRET=
FORWARD_AUTH_EMAIL_HEADER=X-Forwarded-Email

# Optional standard OpenID Connect login (Authorization Code + PKCE).
# The callback URL must exactly match the URI registered at the provider.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=
OIDC_SCOPES="openid email profile"
OIDC_DISPLAY_NAME="OpenID Connect"
OIDC_ALLOW_PROVISIONING=false
OIDC_DISABLE_LOCAL_LOGIN=false

# Development-only ports and API address (`docker-compose.dev.yml`).
POSTGRES_PORT=5432
REDIS_PORT=6379
BACKEND_PORT=8000
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:8000
