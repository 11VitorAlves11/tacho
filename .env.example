POSTGRES_USER=tacho
POSTGRES_PASSWORD=change-me
POSTGRES_DB=tacho
POSTGRES_PORT=5432

DATABASE_URL=postgresql+psycopg2://tacho:change-me@db:5432/tacho
REDIS_URL=redis://redis:6379/0

BACKEND_PORT=8000

FRONTEND_PORT=5173
VITE_API_URL=http://localhost:8000
# CORS_ORIGINS=["http://localhost:5173"]  # default já cobre o dev local

# --- Só para docker-compose.prod.yml (produção) ---
# Por omissão usam volumes Docker nomeados; num deploy real apontar para
# bind mounts persistentes fora do rootfs do container.
# POSTGRES_DATA_DIR=/mnt/vmdata/receitas/postgresql
# IMAGES_DIR=/mnt/vmdata/receitas/mediafiles
# WEB_PORT=80
# Usado só pelo export schema.org (GET /recipes/{id}/export) para gerar a
# URL absoluta da foto. Sem isto, cai em request.base_url — atrás do proxy
# reverso/Authentik da CT 202 isso dava o esquema/host internos, não
# https://receitas.alveslab.dev.
# PUBLIC_BASE_URL=https://receitas.alveslab.dev

# Assina os cookies de sessão (autenticação, v1.2) — OBRIGATÓRIO gerar um
# valor aleatório e secreto para produção (ex. `openssl rand -hex 32`).
# Sem isto, a app usa o valor de omissão do código (público, conhecido),
# o que tornaria as sessões forjáveis por qualquer pessoa que alcance a
# app — o Authentik já limita quem alcança, mas isto é a segunda camada.
# AUTH_SECRET=troca-me-por-um-valor-aleatorio-antes-do-deploy
# https://receitas.alveslab.dev é HTTPS — o cookie "Secure" só viaja em
# HTTPS, por isso produção tem de ligar isto (o valor de omissão é false,
# só para o dev local em http://localhost funcionar).
# AUTH_COOKIE_SECURE=true

# Login silencioso via forward-auth do Authentik (opcional) — evita mostrar
# o login a quem o Authentik, à frente no NPM, já autenticou. Desligado por
# omissão. Só ligar depois de configurar o NPM para injetar
# X-Tacho-Forward-Secret nesta rota (ver checklist no TODO.md, "Login
# silencioso via forward-auth do Authentik") — sem o segredo a bater certo
# com o valor abaixo, um pedido direto ao backend que contornasse o NPM
# conseguia forjar o header de email e entrar como qualquer pessoa.
# TRUST_FORWARD_AUTH=true
# FORWARD_AUTH_SECRET=troca-me-por-um-valor-aleatorio-antes-do-deploy
# FORWARD_AUTH_EMAIL_HEADER=X-authentik-email

# Importação inteligente (fallback de extração + foto/Vision, v1.3) —
# opcional, sem isto a app funciona na mesma. Chave gerada em
# https://aistudio.google.com/apikey.
# GEMINI_API_KEY=
